@page "/reports"
@attribute [Authorize(Roles = "admin")]
@inject ReportsClient Reports

<PageTitle>Reports</PageTitle>

<MudStack Class="mb-6">
    <MudText Typo="Typo.overline" Color="Color.Primary">Reports</MudText>
    <MudText Typo="Typo.h4">Sales</MudText>
    <MudText Typo="Typo.body1">
        Live analytics over Storefront orders. 
    </MudText>
</MudStack>

@if (_failed)
{
    <MudStack Class="mb-4" Spacing="2">
        <MudAlert Severity="Severity.Error">
            <MudText Typo="Typo.subtitle1">Couldn't load the report</MudText>
            <MudText Typo="Typo.body2">Something interrupted the request. Please try again.</MudText>
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@Load">
            Try again
        </MudButton>
    </MudStack>
}
else if (_report is null)
{
    <MudGrid Spacing="3">
        @for (var i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="1" Class="pa-4">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="50%" Class="mb-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" />
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Revenue</MudText>
                <MudText Typo="Typo.h5">@Money.Format(_report.TotalRevenue)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Orders</MudText>
                <MudText Typo="Typo.h5">@_report.TotalOrders.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Units sold</MudText>
                <MudText Typo="Typo.h5">@_report.TotalUnits.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mb-3">Total Revenue by Product Category</MudText>

    @if (_report.ByCategory.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No orders yet — place one in the Storefront and it shows up here.
        </MudAlert>
    }
    else
    {
        @* Chart lives in a full-width card so it fills the content column and aligns under the heading,
           instead of floating centered in empty space beside a left-aligned title. *@
        <MudPaper Elevation="1" Class="pa-4">
            <MudChart
                ChartType="ChartType.Bar"
                ChartSeries="@_chartSeries"
                XAxisLabels="@_chartLabels"
                ChartOptions="_chartOptions"
                Width="100%"
                Height="350px" />
        </MudPaper>
    }
}

@code {
    private SalesReportDto? _report;
    private bool _failed;

    // Brand chart palette: sanctioned hex exception for charts — color-named values can't express
    // the data-vis contrast needed here, so explicit hex mirrors the AtriumTheme status ramp.
    private static readonly ChartOptions _chartOptions = new()
    {
        ChartPalette = ["#117b68", "#2dbd9b", "#16785a", "#8a5a0f", "#a23b3b"],
    };

    // Chart data is populated from _report.ByCategory in Load(); decimal Revenue values are cast to
    // double here at the presentation layer — the contract model stays decimal throughout.
    private List<ChartSeries> _chartSeries = [];
    private string[] _chartLabels = [];

    protected override Task OnInitializedAsync() => Load();

    // A non-session failure composing the report shows an inline retry instead of the shell's generic
    // card; a 401 still surfaces as SessionExpiredException so the re-login prompt takes over.
    private async Task Load()
    {
        _failed = false;
        _report = null;
        try
        {
            _report = await Reports.GetSalesAsync();
            _chartSeries =
            [
                new ChartSeries
                {
                    Name = "Revenue",
                    Data = [.. _report.ByCategory.Select(c => (double)c.Revenue)],
                },
            ];
            _chartLabels = [.. _report.ByCategory.Select(c => c.Category)];
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            _failed = true;
        }
    }
}
