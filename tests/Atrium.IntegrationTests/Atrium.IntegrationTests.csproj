<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- These tests hit a real DB; they don't exercise cancellation, so threading a token through
         every Dapper call would be noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <!-- Mvc.Testing transitively pulls Microsoft.OpenApi 2.0.0, which carries a known high-severity
         advisory (NU1903, GHSA-v5pm-xwqc-g5wc). Pin the patched version to keep the build warning-clean.
         (The services get OpenApi from the ASP.NET Core shared framework, which isn't audited.) -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Reference the real services under test: their repositories, sprocs (embedded), and the DbUp
       DatabaseInitializer are exactly what these tests exercise against a live SQL Server. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Atrium.Services.Catalog\Atrium.Services.Catalog.csproj" />
    <ProjectReference Include="..\..\src\Atrium.Services.Storefront\Atrium.Services.Storefront.csproj" />
  </ItemGroup>
</Project>
