@namespace Atrium.Design
@implements IAsyncDisposable
@inject IJSRuntime JS

@* An accessible modal built on the native <dialog> element (via showModal), so focus trapping,
   Esc-to-close, top-layer stacking and the backdrop come from the platform rather than hand-rolled JS.
   Two-way bind Open; close via Esc, the X, or whatever the caller puts in Footer (e.g. a Cancel button).
   Backdrop clicks intentionally do NOT dismiss — that would discard in-progress edits. *@
<dialog @ref="_dialog" class="dialog" @onclose="OnClose">
    <div class="dialog__panel">
        <header class="dialog__header">
            <h2 class="dialog__title">@Title</h2>
            <button type="button" class="dialog__close" aria-label="Close" @onclick="RequestClose">✕</button>
        </header>
        <div class="dialog__body">
            @ChildContent
        </div>
        @if (Footer is not null)
        {
            <footer class="dialog__footer">
                @Footer
            </footer>
        }
    </div>
</dialog>

@code {
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _shown;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    // Sync the imperative showModal/close calls to the declarative Open parameter after each render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Atrium.Design/js/dialog.js"
            );

            if (Open && !_shown)
            {
                _shown = true;
                await _module.InvokeVoidAsync("showModal", _dialog);
            }
            else if (!Open && _shown)
            {
                _shown = false;
                await _module.InvokeVoidAsync("close", _dialog);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away between render and interop (navigation / disconnect) — the dialog
            // is gone with it, so there's nothing to show or close. DisposeAsync guards the same way.
        }
    }

    // The native dialog closed itself (Esc, or our own close() call). Report it up so Open stays in sync.
    private async Task OnClose()
    {
        _shown = false;
        if (Open)
        {
            await OpenChanged.InvokeAsync(false);
        }
    }

    // X button: ask the parent to close; the Open=false round-trip triggers the JS close().
    private Task RequestClose() => OpenChanged.InvokeAsync(false);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to dispose.
            }
        }
    }
}
