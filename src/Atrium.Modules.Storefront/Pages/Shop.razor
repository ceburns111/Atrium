@page "/storefront"
@implements IDisposable
@inject CatalogClient Catalog
@inject CartService Cart
@inject CartPersistence Persistence
@inject ISnackbar Snackbar

<PageTitle>Storefront</PageTitle>

<MudStack Class="mb-6">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">Storefront</MudText>
            <MudText Typo="Typo.h4">Browse</MudText>
            <MudText Typo="Typo.body1">
                A small catalog of desk goods. Add items to your cart and check out.
            </MudText>
        </div>
        <MudStack Row Spacing="1">
            <MudButton Href="/storefront/orders" Variant="Variant.Text" Color="Color.Default">
                Orders
            </MudButton>
            <MudButton Href="/storefront/cart" Variant="Variant.Outlined" Color="Color.Secondary">
                Cart (@Cart.Count)
            </MudButton>
        </MudStack>
    </MudStack>

    <MudChipSet T="string"
                SelectionMode="SelectionMode.SingleSelection"
                SelectedValue="@(_category ?? string.Empty)"
                SelectedValueChanged="@(async v => await Filter(string.IsNullOrEmpty(v) ? null : v))">
        <MudChip T="string" Value="@string.Empty" Color="Color.Primary">All</MudChip>
        @foreach (var category in _categories)
        {
            <MudChip T="string" Value="@category.Name" Color="Color.Primary">@category.Name</MudChip>
        }
    </MudChipSet>
</MudStack>

@if (_failed)
{
    <MudStack Class="mb-4" Spacing="2">
        <MudAlert Severity="Severity.Error">
            <MudText Typo="Typo.subtitle1">Couldn't load the catalog</MudText>
            <MudText Typo="Typo.body2">Something interrupted the request. Please try again.</MudText>
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@Load">
            Try again
        </MudButton>
    </MudStack>
}
else if (_products is null)
{
    <MudGrid>
        @for (var i = 0; i < 8; i++)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
                    <MudCardContent>
                        <MudSkeleton Width="70%" />
                        <MudSkeleton Width="40%" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
else if (_products.Count == 0)
{
    <MudAlert Severity="Severity.Info">No products in this category.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var product in _products)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard>
                    <ProductThumb Name="@product.Name" />
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1">@product.Name</MudText>
                        <MudText Typo="Typo.body2">@product.Blurb</MudText>
                        <MudText Typo="Typo.h6" Class="mt-2">@Money.Format(product.Price)</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudSpacer />
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="@(() => Add(product))">
                            Add
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private IReadOnlyList<CategoryDto> _categories = [];
    private IReadOnlyList<ProductDto>? _products;
    private string? _category;
    private bool _failed;
    private int _loadSequence;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += Refresh;
        await Load();
    }

    // A non-session failure (500/timeout/drop) here shows an inline retry instead of tearing the whole
    // page down to the shell error boundary; a 401 still surfaces as SessionExpiredException so the
    // shell's re-login prompt wins.
    private async Task Load()
    {
        // Sequence guard: rapid chip clicks overlap requests, and responses can land out of order.
        // Only the latest Load may assign _products (or flag a failure) — a stale response for a
        // previously selected category is dropped instead of winning last-write. UI events run on
        // the circuit's sync context, so a plain int is race-free here.
        var sequence = ++_loadSequence;
        _failed = false;
        try
        {
            if (_categories.Count == 0)
            {
                _categories = await Catalog.GetCategoriesAsync();
            }
            _products = null;
            StateHasChanged();
            var products = await Catalog.GetProductsAsync(_category);
            if (sequence == _loadSequence)
            {
                _products = products;
            }
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            if (sequence == _loadSequence)
            {
                _failed = true;
            }
        }
    }

    // Rehydrate the persisted cart on the first interactive render (never during prerender — JS interop
    // is unavailable then, per ADR-0010) so the cart badge is accurate on any entry into the storefront.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Persistence.HydrateAsync();
        }
    }

    private async Task Filter(string? category)
    {
        _category = category;
        await Load();
    }

    private void Add(ProductDto product)
    {
        Cart.Add(product);
        Snackbar.Add($"Added {product.Name}", Severity.Success);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= Refresh;
}
