@page "/storefront"
@implements IDisposable
@inject CartService Cart
@inject ToastService Toasts

<PageTitle>Storefront</PageTitle>

<PageHeader Eyebrow="Storefront"
            Title="Browse"
            Description="A small catalog of desk goods. Add items to your cart and check out.">
    <Actions>
        <a class="btn btn--secondary" href="/storefront/cart">Cart (@Cart.Count)</a>
    </Actions>
</PageHeader>

<div class="filters">
    <button class="chip @(_category is null ? "chip--on" : null)" @onclick="() => Filter(null)">All</button>
    @foreach (var category in ProductCatalog.Categories)
    {
        <button class="chip @(_category == category ? "chip--on" : null)" @onclick="() => Filter(category)">@category</button>
    }
</div>

<div class="product-grid">
    @foreach (var product in Visible)
    {
        <div class="product">
            <div class="product__thumb">@product.Category</div>
            <div class="product__name">@product.Name</div>
            <div class="product__blurb">@product.Blurb</div>
            <div class="product__foot">
                <span class="product__price">$@product.Price.ToString("N0")</span>
                <Button Small Variant="ButtonVariant.Secondary" OnClick="() => Add(product)">Add</Button>
            </div>
        </div>
    }
</div>

@code {
    private string? _category;

    private IEnumerable<Product> Visible =>
        _category is null
            ? ProductCatalog.Products
            : ProductCatalog.Products.Where(p => p.Category == _category);

    private void Filter(string? category) => _category = category;

    private void Add(Product product)
    {
        Cart.Add(product);
        Toasts.Show($"Added {product.Name}", ToastVariant.Success);
    }

    protected override void OnInitialized() => Cart.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= Refresh;
}
