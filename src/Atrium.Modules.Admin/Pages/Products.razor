@page "/admin"
@attribute [Authorize]
@inject AdminCatalogClient Catalog
@inject ToastService Toasts

<PageTitle>Admin</PageTitle>

<PageHeader Eyebrow="Admin"
            Title="Products"
            Description="Create and edit catalog products. Saving requires the admin role — sign in as admin to make changes.">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" OnClick="StartCreate">New product</Button>
    </Actions>
</PageHeader>

@if (_products is null)
{
    <div class="table-scroll">
        <table class="atrium-table admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="num">Price</th>
                    <th>Blurb</th>
                    <th aria-label="Actions"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < 5; i++)
                {
                    <tr>
                        <td><span class="skeleton skeleton-line"></span></td>
                        <td><span class="skeleton skeleton-line"></span></td>
                        <td class="num"><span class="skeleton skeleton-line"></span></td>
                        <td><span class="skeleton skeleton-line"></span></td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_products.Count == 0)
{
    <p class="empty">No products yet.</p>
}
else
{
    <div class="table-scroll">
        <table class="atrium-table admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="num">Price</th>
                    <th>Blurb</th>
                    <th aria-label="Actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in _products)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td><Badge>@product.Category</Badge></td>
                        <td class="num">$@product.Price.ToString("N0")</td>
                        <td class="admin-table__blurb">@product.Blurb</td>
                        <td class="admin-table__actions">
                            <Button Small Variant="ButtonVariant.Secondary" OnClick="() => StartEdit(product)">Edit</Button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* One dialog + one form serves both create and edit — _editingId (null = create) picks the mode. *@
<Dialog Open="_dialogOpen" OpenChanged="OnDialogOpenChanged" Title="@DialogTitle">
    <ChildContent>
        <Field Label="Name">
            <input class="input" @bind="_form.Name" placeholder="Walnut Monitor Shelf" />
        </Field>
        <Field Label="Category">
            <select class="select" @bind="_form.Category">
                @foreach (var category in _categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </Field>
        <Field Label="Price">
            <input class="input" type="number" min="0" step="1" @bind="_form.Price" />
        </Field>
        <Field Label="Blurb">
            <input class="input" @bind="_form.Blurb" placeholder="One-line description." />
        </Field>
    </ChildContent>
    <Footer>
        <Button OnClick="Save" Disabled="_saving">@SaveLabel</Button>
        <Button Variant="ButtonVariant.Ghost" OnClick="Cancel" Disabled="_saving">Cancel</Button>
    </Footer>
</Dialog>

@code {
    private IReadOnlyList<ProductDto>? _products;
    private IReadOnlyList<string> _categories = [];
    private int? _editingId; // null = creating a new product
    private bool _dialogOpen;
    private bool _saving;
    private readonly ProductForm _form = new();

    private string DialogTitle => _editingId is null ? "New product" : "Edit product";
    private string SaveLabel => _editingId is null ? "Add product" : "Save";

    protected override async Task OnInitializedAsync()
    {
        _categories = (await Catalog.GetCategoriesAsync()).Select(c => c.Name).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync() => _products = await Catalog.GetProductsAsync();

    private void StartCreate()
    {
        _form.Reset(_categories.FirstOrDefault() ?? "");
        _editingId = null;
        _dialogOpen = true;
    }

    private void StartEdit(ProductDto product)
    {
        _form.Set(product);
        _editingId = product.Id;
        _dialogOpen = true;
    }

    private void Cancel() => _dialogOpen = false;

    // Fired by Esc / the X close button (relayed by Dialog) as well as our own Cancel round-trip.
    private void OnDialogOpenChanged(bool open) => _dialogOpen = open;

    private async Task Save()
    {
        _saving = true;
        var (product, error) = _editingId is null
            ? await Catalog.CreateProductAsync(
                new CreateProductRequest(_form.Name, _form.Category, _form.Price, _form.Blurb)
            )
            : await Catalog.UpdateProductAsync(
                _editingId.Value,
                new UpdateProductRequest(_form.Name, _form.Category, _form.Price, _form.Blurb)
            );
        _saving = false;

        if (error is not null)
        {
            Toasts.Show(error, ToastVariant.Danger);
            return; // keep the dialog open so the user can fix and retry
        }

        Toasts.Show(
            $"{(_editingId is null ? "Created" : "Saved")} {product!.Name}",
            ToastVariant.Success
        );
        _dialogOpen = false;
        await LoadAsync();
    }

    private sealed class ProductForm
    {
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Price { get; set; }
        public string Blurb { get; set; } = "";

        public void Reset(string category)
        {
            Name = "";
            Category = category;
            Price = 0;
            Blurb = "";
        }

        public void Set(ProductDto product)
        {
            Name = product.Name;
            Category = product.Category;
            Price = product.Price;
            Blurb = product.Blurb;
        }
    }
}
