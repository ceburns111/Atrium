@* Routable so a full-page GET to a role-gated route (deep-link / refresh / bookmark) lands here via
   the cookie handler's AccessDeniedPath; also rendered inline by Routes.razor's <NotAuthorized>. *@
@page "/forbidden"
@layout MainLayout

<PageTitle>Access denied</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5">Access denied</MudText>
        <MudText Typo="Typo.body1">You don't have permission to view this page.</MudText>
        <div>
            <MudButton Variant="Variant.Outlined" Href="/">Return to home</MudButton>
        </div>
    </MudStack>
</MudContainer>
