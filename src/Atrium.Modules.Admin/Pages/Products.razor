@page "/admin"
@attribute [Authorize(Roles = "admin")]
@inject AdminCatalogClient Catalog
@inject ToastService Toasts

<PageTitle>Admin</PageTitle>

<PageHeader Eyebrow="Admin"
            Title="Products"
            Description="Create and edit catalog products. Saving requires the admin role — sign in as admin to make changes.">
    <Actions>
        <Button Variant="ButtonVariant.Secondary" OnClick="StartCreate">New product</Button>
    </Actions>
</PageHeader>

@if (_failed)
{
    <Notice Title="Couldn't load products"
            Body="Something interrupted the request. Please try again.">
        <Button Variant="ButtonVariant.Secondary" OnClick="Load">Try again</Button>
    </Notice>
}
else if (_products is null)
{
    <div class="table-scroll">
        <table class="atrium-table admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="num">Price</th>
                    <th>Blurb</th>
                    <th aria-label="Actions"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < 5; i++)
                {
                    <tr>
                        <td><span class="skeleton skeleton-line"></span></td>
                        <td><span class="skeleton skeleton-line"></span></td>
                        <td class="num"><span class="skeleton skeleton-line"></span></td>
                        <td><span class="skeleton skeleton-line"></span></td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_products.Count == 0)
{
    <p class="empty">No products yet.</p>
}
else
{
    <div class="table-scroll">
        <table class="atrium-table admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="num">Price</th>
                    <th>Blurb</th>
                    <th aria-label="Actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in _products)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td><Badge>@product.Category</Badge></td>
                        <td class="num">@Money.Format(product.Price)</td>
                        <td class="admin-table__blurb">@product.Blurb</td>
                        <td class="admin-table__actions">
                            <Button Small Variant="ButtonVariant.Secondary" OnClick="() => StartEdit(product)">Edit</Button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* One dialog + one form serves both create and edit — _editingId (null = create) picks the mode. *@
<Dialog Open="_dialogOpen" OpenChanged="OnDialogOpenChanged" Title="@DialogTitle">
    <ChildContent>
        <Field Label="Name" For="product-name">
            <input id="product-name" class="input" required @bind="_form.Name" @bind:event="oninput"
                   placeholder="Walnut Monitor Shelf" />
        </Field>
        <Field Label="Category" For="product-category">
            <select id="product-category" class="select" @bind="_form.Category">
                @foreach (var category in _categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </Field>
        <Field Label="Price" For="product-price">
            <input id="product-price" class="input" type="number" min="0.01" step="0.01" required
                   @bind="_form.Price" @bind:event="oninput" />
        </Field>
        <Field Label="Blurb" For="product-blurb">
            <input id="product-blurb" class="input" required @bind="_form.Blurb" @bind:event="oninput"
                   placeholder="One-line description." />
        </Field>
    </ChildContent>
    <Footer>
        <Button OnClick="Save" Disabled="_saving || !FormValid">@SaveLabel</Button>
        <Button Variant="ButtonVariant.Ghost" OnClick="Cancel" Disabled="_saving">Cancel</Button>
    </Footer>
</Dialog>

@code {
    private IReadOnlyList<ProductDto>? _products;
    private IReadOnlyList<string> _categories = [];
    private int? _editingId; // null = creating a new product
    private bool _dialogOpen;
    private bool _saving;
    private bool _failed;
    private readonly ProductForm _form = new();

    private string DialogTitle => _editingId is null ? "New product" : "Edit product";
    private string SaveLabel => _editingId is null ? "Add product" : "Save";

    // Client-side gate so an empty Name/Blurb or a zero Price can't be submitted for a server 400
    // round-trip; the Save button stays disabled until the form is valid. Price must round-trip
    // through the displayed cents precision (DECIMAL(10,2) in the schema, Money.Format on screen),
    // so anything past two decimals is rejected here rather than silently truncated later.
    private bool FormValid =>
        !string.IsNullOrWhiteSpace(_form.Name)
        && !string.IsNullOrWhiteSpace(_form.Blurb)
        && !string.IsNullOrWhiteSpace(_form.Category)
        && _form.Price > 0
        && decimal.Round(_form.Price, 2) == _form.Price;

    protected override Task OnInitializedAsync() => Load();

    // Guard the initial read so a non-session failure gets an inline retry instead of the shell's
    // generic card. (The create/edit write path already surfaces failures as inline toasts.) A 401
    // still bubbles as SessionExpiredException so the shell's re-login prompt wins.
    private async Task Load()
    {
        _failed = false;
        try
        {
            if (_categories.Count == 0)
            {
                _categories = (await Catalog.GetCategoriesAsync()).Select(c => c.Name).ToList();
            }
            _products = await Catalog.GetProductsAsync();
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            _failed = true;
        }
    }

    private void StartCreate()
    {
        _form.Reset(_categories.FirstOrDefault() ?? "");
        _editingId = null;
        _dialogOpen = true;
    }

    private void StartEdit(ProductDto product)
    {
        _form.Set(product);
        _editingId = product.Id;
        _dialogOpen = true;
    }

    private void Cancel() => _dialogOpen = false;

    // Fired by Esc / the X close button (relayed by Dialog) as well as our own Cancel round-trip.
    private void OnDialogOpenChanged(bool open) => _dialogOpen = open;

    private async Task Save()
    {
        // Belt-and-suspenders with the disabled Save button: ignore a re-entrant call while a save is
        // already in flight, matching Checkout.Pay's guard.
        if (_saving)
        {
            return;
        }
        _saving = true;
        try
        {
            var (product, error) = _editingId is null
                ? await Catalog.CreateProductAsync(
                    new CreateProductRequest(_form.Name, _form.Category, _form.Price, _form.Blurb)
                )
                : await Catalog.UpdateProductAsync(
                    _editingId.Value,
                    new UpdateProductRequest(_form.Name, _form.Category, _form.Price, _form.Blurb)
                );

            if (error is not null)
            {
                Toasts.Show(error, ToastVariant.Danger);
                return; // keep the dialog open so the user can fix and retry
            }

            Toasts.Show(
                $"{(_editingId is null ? "Created" : "Saved")} {product!.Name}",
                ToastVariant.Success
            );
            _dialogOpen = false;
            await Load();
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            // A transient failure (e.g. a 502 from the gateway) stays an inline toast, matching
            // Checkout.Pay's shape: the dialog stays open with the typed edits intact so the user
            // can just retry. A 401 still bubbles as SessionExpiredException for the shell's
            // re-login prompt.
            Toasts.Show(
                "Something went wrong saving the product. Please try again.",
                ToastVariant.Danger
            );
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class ProductForm
    {
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Price { get; set; }
        public string Blurb { get; set; } = "";

        public void Reset(string category)
        {
            Name = "";
            Category = category;
            Price = 0;
            Blurb = "";
        }

        public void Set(ProductDto product)
        {
            Name = product.Name;
            Category = product.Category;
            Price = product.Price;
            Blurb = product.Blurb;
        }
    }
}
