@inject Atrium.Portal.Modularity.ModuleCatalog Catalog

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Atrium</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
        </div>
        @* Navigation is contributed by discovered modules, not hard-coded. *@
        @foreach (var item in Catalog.Modules.SelectMany(m => m.NavItems))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@item.Path">@item.Title</NavLink>
            </div>
        }
    </nav>
</div>
