@namespace Atrium.Design

@* A centered card for a whole-region message: a failed load with a retry, a wrong-role notice, a
   not-found dead-end, an expired session. Title + optional body + a caller-supplied action, so every
   "something to tell the user" moment looks like one product instead of ad-hoc markup per screen. *@
<div class="notice card">
    <h2 class="notice__title">@Title</h2>
    @if (!string.IsNullOrEmpty(Body))
    {
        <p class="notice__body">@Body</p>
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Body { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
