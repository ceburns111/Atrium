<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\Atrium.Contracts\Atrium.Contracts.csproj" />
    <ProjectReference Include="..\Atrium.ServiceDefaults\Atrium.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Keycloak.Authentication" Version="13.4.6-preview.1.26319.6" />
    <PackageReference Include="Aspire.Microsoft.Data.SqlClient" Version="13.4.6" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.12.0" />
    <PackageReference
      Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore"
      Version="1.12.0-preview.260629.1"
    />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Config-driven IChatClient for the support agent: the MEAI OpenAI integration exposes
         .AsIChatClient() on the OpenAI SDK client, which the real FoundryLocal/AzureFoundry providers
         build. OpenAI 2.10.0 is pinned to match MEAI.OpenAI 10.6.0's transitive dependency exactly
         (both stable; keeps the build at 0 warnings). -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <!-- Pin the patched Microsoft.OpenApi: AspNetCore.OpenApi 10.0.9 pulls 2.0.0 transitively, which
         carries a high-severity advisory (NU1903, GHSA-v5pm-xwqc-g5wc). Matches the pin in
         Atrium.IntegrationTests; the advisory surfaced repo-wide on the fresh MAF restore in this item. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Scripts\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atrium.UnitTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
