@page "/"
@inject Atrium.Portal.Modularity.ModuleCatalog Catalog

<PageTitle>Atrium</PageTitle>

<PageHeader Eyebrow="Workspace"
            Title="Atrium"
            Description="A modular host. Each app below is a self-contained module the host discovered at startup — add a new one and it appears here, no host changes." />

<div class="section-label">Apps</div>

@if (Catalog.Modules.Count == 0)
{
    <p class="empty">No modules discovered yet.</p>
}
else
{
    <div class="module-grid">
        @foreach (var module in Catalog.Modules)
        {
            <a class="module-card" href="@module.BasePath">
                <div class="module-card__mono" style="@MonoStyle(module)">@module.Name[..1]</div>
                <div class="module-card__name">@module.Name</div>
                <div class="module-card__desc">@module.Description</div>
                <div class="module-card__foot">
                    <span class="module-card__path">@module.BasePath</span>
                    <span class="module-card__go">Open &rarr;</span>
                </div>
            </a>
        }
    </div>
}

@code {
    // Tint the monogram with the module's own accent; falls back to the host accent.
    private static string? MonoStyle(Atrium.Abstractions.IModule module) =>
        module.Accent is null ? null : $"--mono:{module.Accent}";
}
