{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/catalog/{**catch-all}" }
      },
      "storefront": {
        "ClusterId": "storefront",
        "Match": { "Path": "/storefront/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog": { "Address": "https+http://catalog" }
        }
      },
      "storefront": {
        "Destinations": {
          "storefront": { "Address": "https+http://storefront" }
        }
      }
    }
  }
}
