@* The UseExceptionHandler("/Error") re-execute target — statically rendered after an unhandled
   server-side exception. Same Notice treatment as NotFound/Forbidden, plus the request id so a
   user report can be matched to the server logs/trace. *@
@page "/Error"
@layout MainLayout
@using System.Diagnostics

<PageTitle>Something went wrong</PageTitle>

<Notice Title="Something went wrong" Body="An unexpected error occurred while processing your request.">
    @if (ShowRequestId)
    {
        <p class="notice__body">Request ID: <code>@RequestId</code></p>
    }
    <a class="btn btn--secondary" href="/">Return to home</a>
</Notice>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
