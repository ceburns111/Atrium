@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject Atrium.Design.AccessTokenHolder Tokens

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" Theme="Atrium.Design.AtriumTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleNav"
                       aria-label="Toggle navigation" />
        <MudText Typo="Typo.h6">Atrium</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary ml-2">/ @Section</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleDarkMode"
                       aria-label="Toggle dark mode" />
        <UserMenu />
    </MudAppBar>

    <MudDrawer @bind-Open="_navOpen"
               ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Responsive"
               Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @* One shared content frame: a centered max-width column with responsive gutters + vertical
           rhythm, so every module page is padded consistently instead of bleeding to the window edge. *@
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            <SessionErrorBoundary @ref="_errorBoundary">
                @Body
            </SessionErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _navOpen = true;
    private bool _isDarkMode;
    private MudThemeProvider? _themeProvider;
    private SessionErrorBoundary? _errorBoundary;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    // Capture the signed-in user's access token so module HttpClients can attach it on every request.
    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            Tokens.AccessToken = (await AuthState).User.FindFirst("access_token")?.Value;
        }
    }

    // Seed dark mode from the OS preference on first interactive render; the pre-Blazor script in
    // App.razor already applies the theme before paint, so this only aligns the reactive flag.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private void ToggleNav() => _navOpen = !_navOpen;

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    // Close the mobile drawer on navigation and refresh the breadcrumb.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // LocationChanged fires off the dispatcher, so everything that touches component state —
        // including Recover(), which mutates the boundary and re-renders it — goes through one
        // InvokeAsync rather than mutating from this thread and dispatching only the StateHasChanged.
        InvokeAsync(() =>
        {
            _navOpen = false;
            // Clear any error card so the newly-navigated page gets a fresh attempt (recommended for a
            // layout-scoped boundary, which otherwise stays in its error state across navigations).
            _errorBoundary?.Recover();
            StateHasChanged();
        });
    }

    // The current top-level section, derived from the route, e.g. "/storefront/cart" -> "Storefront".
    private string Section
    {
        get
        {
            var segments = new Uri(Nav.Uri).AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length == 0 ? "Home" : char.ToUpperInvariant(segments[0][0]) + segments[0][1..];
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
