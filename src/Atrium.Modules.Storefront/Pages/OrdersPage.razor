@page "/storefront/orders"
@attribute [Authorize]
@using System.Globalization
@inject OrdersClient Orders

<PageTitle>Orders</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
    <div>
        <MudText Typo="Typo.overline" Color="Color.Primary">Storefront</MudText>
        <MudText Typo="Typo.h4">Orders</MudText>
        <MudText Typo="Typo.body1">
            Your order history, served by the Storefront app service from its own database.
        </MudText>
    </div>
    <MudButton Href="/storefront" Variant="Variant.Outlined" Color="Color.Secondary">Browse</MudButton>
</MudStack>

@if (_failed)
{
    <MudStack Class="mb-4" Spacing="2">
        <MudAlert Severity="Severity.Error">
            <MudText Typo="Typo.subtitle1">Couldn't load your orders</MudText>
            <MudText Typo="Typo.body2">Something interrupted the request. Please try again.</MudText>
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@Load">Try again</MudButton>
    </MudStack>
}
else if (_orders is null)
{
    @for (var i = 0; i < 3; i++)
    {
        <MudCard Class="mb-3">
            <MudCardContent>
                <MudSkeleton Width="35%" />
                <MudSkeleton Width="75%" Class="mt-2" />
            </MudCardContent>
        </MudCard>
    }
}
else if (_orders.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No orders yet. <MudLink Href="/storefront">Browse products</MudLink>.
    </MudAlert>
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var order in _orders)
        {
            <MudExpansionPanel>
                <TitleContent>
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-grow-1 pr-2">
                        <MudText Typo="Typo.subtitle1">Order #@order.Id</MudText>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="4">
                            @* Rendered in Blazor Server, so ToLocalTime() would be the SERVER's timezone (UTC in a
                               container), not the visitor's — render the stored UTC instant honestly instead. *@
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @order.PlacedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)
                            </MudText>
                            <MudText Typo="Typo.subtitle2">@Money.Format(order.Total)</MudText>
                        </MudStack>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudSimpleTable Dense="true" Hover="true">
                        <tbody>
                            @foreach (var line in order.Lines)
                            {
                                <tr>
                                    <td>@line.ProductName</td>
                                    <td style="text-align:right">@Money.Format(line.UnitPrice)</td>
                                    <td style="text-align:right">×@line.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@code {
    private IReadOnlyList<OrderDto>? _orders;
    private bool _failed;

    protected override Task OnInitializedAsync() => Load();

    // Reads are idempotent, so a non-session failure gets an inline retry rather than the shell's
    // generic error card; a 401 still bubbles as SessionExpiredException for the re-login prompt.
    private async Task Load()
    {
        _failed = false;
        _orders = null;
        try
        {
            _orders = await Orders.GetOrdersAsync();
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            _failed = true;
        }
    }
}
