@namespace Atrium.Design
@implements IDisposable
@inject ToastService Toasts

<div class="toast-host">
    @foreach (var toast in Toasts.Toasts)
    {
        <div class="toast toast--@toast.Variant.ToString().ToLowerInvariant()" role="status">
            <span class="toast__msg">@toast.Message</span>
            <button class="toast__close" @onclick="() => Toasts.Dismiss(toast.Id)" aria-label="Dismiss">&times;</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Toasts.Changed -= OnChanged;
}
