@namespace Atrium.Design

@* A small dropdown menu: a click-to-toggle trigger and a panel of items positioned below-right.
   Closes on outside-click (a transparent full-viewport backdrop — the same no-JS trick the shell's
   nav-backdrop uses) and on Esc. Consumers supply the panel body (.menu__header / .menu__item);
   there's no MenuItem sub-component yet — only UserMenu uses this today. *@
<div class="menu" @onkeydown="OnKeyDown">
    <button type="button"
            class="menu__trigger @TriggerClass"
            @onclick="Toggle"
            aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")"
            aria-label="@Label"
            title="@Label">
        @Trigger
    </button>
    @if (_open)
    {
        <div class="menu__backdrop" @onclick="Close"></div>
        <div class="menu__panel" role="menu" tabindex="-1" @ref="_panel">
            @ChildContent
        </div>
    }
</div>

@code {
    // The clickable trigger's inner content (e.g. an avatar); ChildContent is the panel body.
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? TriggerClass { get; set; }

    private bool _open;
    private ElementReference _panel;
    private bool _focusPanel;

    private void Toggle()
    {
        _open = !_open;
        // Pull focus into the panel on open so Esc (handled on the wrapper) reliably fires and keyboard
        // users land inside the menu. The [tabindex="-1"]:focus rule keeps it from drawing a ring.
        _focusPanel = _open;
    }

    private void Close() => _open = false;

    // Esc closes; keydown bubbles up from the focused panel to this wrapper.
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPanel)
        {
            _focusPanel = false;
            try
            {
                await _panel.FocusAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit dropped between render and focus — nothing to focus.
            }
        }
    }
}
