@page "/storefront"
@attribute [Authorize]
@implements IDisposable
@inject CatalogClient Catalog
@inject CartService Cart
@inject ToastService Toasts

<PageTitle>Storefront</PageTitle>

<PageHeader Eyebrow="Storefront"
            Title="Browse"
            Description="A small catalog of desk goods. Add items to your cart and check out.">
    <Actions>
        <a class="btn btn--ghost" href="/storefront/orders">Orders</a>
        <a class="btn btn--secondary" href="/storefront/cart">Cart (@Cart.Count)</a>
    </Actions>
</PageHeader>

<div class="filters">
    <button class="chip @(_category is null ? "chip--on" : null)" @onclick="() => Filter(null)">All</button>
    @foreach (var category in _categories)
    {
        <button class="chip @(_category == category.Name ? "chip--on" : null)" @onclick="() => Filter(category.Name)">
            @category.Name
        </button>
    }
</div>

@if (_failed)
{
    <Notice Title="Couldn't load the catalog"
            Body="Something interrupted the request. Please try again.">
        <Button Variant="ButtonVariant.Secondary" OnClick="Load">Try again</Button>
    </Notice>
}
else if (_products is null)
{
    <div class="product-grid">
        @for (var i = 0; i < 8; i++)
        {
            <div class="product product--skeleton skeleton"></div>
        }
    </div>
}
else if (_products.Count == 0)
{
    <p class="empty">No products in this category.</p>
}
else
{
    <div class="product-grid">
        @foreach (var product in _products)
        {
            <div class="product">
                <div class="product__thumb">@product.Category</div>
                <div class="product__name">@product.Name</div>
                <div class="product__blurb">@product.Blurb</div>
                <div class="product__foot">
                    <span class="product__price">$@product.Price.ToString("N0")</span>
                    <Button Small Variant="ButtonVariant.Secondary" OnClick="() => Add(product)">Add</Button>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<CategoryDto> _categories = [];
    private IReadOnlyList<ProductDto>? _products;
    private string? _category;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        Cart.Changed += Refresh;
        await Load();
    }

    // A non-session failure (500/timeout/drop) here shows an inline retry instead of tearing the whole
    // page down to the shell error boundary; a 401 still surfaces as SessionExpiredException so the
    // shell's re-login prompt wins.
    private async Task Load()
    {
        _failed = false;
        try
        {
            if (_categories.Count == 0)
            {
                _categories = await Catalog.GetCategoriesAsync();
            }
            _products = null;
            StateHasChanged();
            _products = await Catalog.GetProductsAsync(_category);
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            _failed = true;
        }
    }

    private async Task Filter(string? category)
    {
        _category = category;
        await Load();
    }

    private void Add(ProductDto product)
    {
        Cart.Add(product);
        Toasts.Show($"Added {product.Name}", ToastVariant.Success);
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= Refresh;
}
