@page "/storefront/checkout"
@attribute [Authorize]
@implements IDisposable
@inject CartService Cart
@inject CartPersistence Persistence
@inject PaymentService Payments
@inject OrdersClient Orders

<PageTitle>Checkout</PageTitle>

<MudStack Class="mb-6">
    <div>
        <MudText Typo="Typo.overline" Color="Color.Primary">Storefront</MudText>
        <MudText Typo="Typo.h4">Checkout</MudText>
        <MudText Typo="Typo.body1">Review your order and pay to place it.</MudText>
    </div>
</MudStack>

@if (_confirmation is not null)
{
    <MudAlert Severity="Severity.Success">
        <MudText Typo="Typo.h6" GutterBottom="true">Order confirmed — thank you!</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            Your payment was approved and your order is on its way.
        </MudText>
        <MudStack Spacing="1" Class="mb-4">
            <MudStack Row Justify="Justify.SpaceBetween">
                <MudText>Order</MudText>
                <MudText><strong>#@_confirmation.OrderId</strong></MudText>
            </MudStack>
            <MudStack Row Justify="Justify.SpaceBetween">
                <MudText>Total</MudText>
                <MudText><strong>@Money.Format(_confirmation.Total)</strong></MudText>
            </MudStack>
            <MudStack Row Justify="Justify.SpaceBetween">
                <MudText>Payment reference</MudText>
                <MudText><strong>@_confirmation.Reference</strong></MudText>
            </MudStack>
        </MudStack>
        <MudStack Row Spacing="2">
            <MudButton Href="/storefront/orders"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                View your orders
            </MudButton>
            <MudButton Href="/storefront"
                       Variant="Variant.Text"
                       Color="Color.Default">
                Keep shopping
            </MudButton>
        </MudStack>
    </MudAlert>
}
else if (Cart.Lines.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        Your cart is empty. <MudLink Href="/storefront">Browse products</MudLink>.
    </MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Order Summary</MudText>
                @* MudStack rows rather than a MudSimpleTable: line items become direct children of the
                   card, so they share the pa-4 left edge and an even rhythm with the heading and Total —
                   the table added its own cell padding on top, throwing the spacing off (last row worst). *@
                <MudStack Spacing="3">
                    @foreach (var line in Cart.Lines)
                    {
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Baseline">
                                <MudText Typo="Typo.body2">@line.Product.Name</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">×@line.Quantity</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2">@Money.Format(line.Product.Price * line.Quantity)</MudText>
                        </MudStack>
                    }
                </MudStack>
                <MudDivider Class="my-3" />
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1">Total</MudText>
                    <MudText Typo="Typo.h6">@Money.Format(Cart.Total)</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-1">Payment</MudText>
                @if (_declineReason is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@_declineReason</MudAlert>
                }

                @* Fields sized to their content, not stretched to the container: cardholder on its
                   own row, then a compact card-number / expiry / CVC line. *@
                <MudForm>
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="8">
                            <MudTextField T="string"
                                          Label="Cardholder name"
                                          @bind-Value="_cardholderName"
                                          Immediate="true"
                                          Error="@(_cardholderError is not null)"
                                          ErrorText="@_cardholderError"
                                          UserAttributes="@_noAutoComplete" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string"
                                          Label="Card number"
                                          @bind-Value="_cardNumber"
                                          Immediate="true"
                                          Placeholder="4242 4242 4242 4242"
                                          Error="@(_cardError is not null)"
                                          ErrorText="@_cardError"
                                          UserAttributes="@_numericAttrs" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudTextField T="string"
                                          Label="Expiry (MM/YY)"
                                          @bind-Value="_expiry"
                                          Immediate="true"
                                          Placeholder="MM/YY"
                                          Error="@(_expiryError is not null)"
                                          ErrorText="@_expiryError"
                                          UserAttributes="@_numericAttrs" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudTextField T="string"
                                          Label="CVC"
                                          @bind-Value="_cvc"
                                          Immediate="true"
                                          Placeholder="123"
                                          Error="@(_cvcError is not null)"
                                          ErrorText="@_cvcError"
                                          UserAttributes="@_numericAttrs" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="Pay"
                                   Disabled="@_processing">
                            @(_processing ? "Processing…" : $"Pay {Money.Format(Cart.Total)}")
                        </MudButton>
                    </MudStack>
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly Dictionary<string, object?> _numericAttrs = new()
    {
        { "inputmode", "numeric" },
        { "autocomplete", "off" },
    };

    private static readonly Dictionary<string, object?> _noAutoComplete = new()
    {
        { "autocomplete", "off" },
    };

    // Card fields live ONLY in component state for the duration of the transaction and are cleared after
    // authorization. The PAN, CVC, and expiry are never persisted, logged, or sent anywhere but the mock
    // PaymentService — the order itself carries only product ids + quantities.
    private string _cardholderName = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvc = "";

    private string? _cardholderError;
    private string? _cardError;
    private string? _expiryError;
    private string? _cvcError;
    private string? _declineReason;

    private bool _processing;

    // One idempotency key per checkout attempt — reused across retries of the same cart (the server
    // dedupes, so an ambiguous failure can't create a duplicate) and only rotated after a placement.
    private Guid _orderKey = Guid.NewGuid();

    private Confirmation? _confirmation;

    private sealed record Confirmation(int OrderId, decimal Total, string Reference);

    protected override void OnInitialized() => Cart.Changed += Refresh;

    // Rehydrate the persisted cart on the first INTERACTIVE render only (never during prerender — ADR-0010).
    // Covers a direct/deep-linked visit to /storefront/checkout that arrives in a fresh circuit after the
    // full-page sign-in; the CartPersistence _hydrated guard makes it a no-op on the normal cart→checkout nav.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Persistence.HydrateAsync();
        }
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= Refresh;

    private async Task Pay()
    {
        if (_processing)
        {
            return;
        }

        if (!Validate())
        {
            return;
        }

        _processing = true;
        _declineReason = null;
        try
        {
            var authorization = await Payments.AuthorizeAsync(
                new PaymentRequest(_cardholderName, _cardNumber, _expiry, _cvc, Cart.Total)
            );

            if (!authorization.Approved)
            {
                _declineReason = authorization.DeclineReason;
                return; // do not place the order; let them retry with a different card
            }

            var request = new CreateOrderRequest(
                Cart.Lines.Select(l => new OrderItemRequest(l.Product.Id, l.Quantity)).ToList(),
                _orderKey
            );
            // CreateAsync never returns null — an unexpected empty success body throws in the client
            // and lands in the catch below, keeping the cart and the same idempotency key.
            var order = await Orders.CreateAsync(request);

            Cart.Clear(); // also clears the persisted cart via CartPersistence
            _orderKey = Guid.NewGuid();
            ClearCardFields();
            _confirmation = new Confirmation(order.Id, order.Total, authorization.Reference!);
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            // Let SessionExpiredException reach the error boundary (re-login). For other failures keep
            // the cart and the same idempotency key so a retry reuses it and can't double-place.
            _declineReason = "Something went wrong placing your order. Please try again.";
        }
        finally
        {
            _processing = false;
        }
    }

    private bool Validate()
    {
        _cardholderError = PaymentValidation.IsValidCardholder(_cardholderName)
            ? null
            : "Enter the name on the card.";
        _cardError = PaymentValidation.IsValidCardNumber(_cardNumber)
            ? null
            : "Enter a valid card number.";
        _expiryError = PaymentValidation.IsValidExpiry(_expiry, DateOnly.FromDateTime(DateTime.Today))
            ? null
            : "Enter a valid future expiry (MM/YY).";
        _cvcError = PaymentValidation.IsValidCvc(_cvc) ? null : "Enter a 3–4 digit CVC.";

        return _cardholderError is null
            && _cardError is null
            && _expiryError is null
            && _cvcError is null;
    }

    private void ClearCardFields()
    {
        _cardholderName = "";
        _cardNumber = "";
        _expiry = "";
        _cvc = "";
    }
}
