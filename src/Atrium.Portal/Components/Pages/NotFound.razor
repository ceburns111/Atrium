@page "/not-found"
@layout MainLayout

<PageTitle>Not found</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5">Page not found</MudText>
        <MudText Typo="Typo.body1">Sorry, the content you are looking for does not exist.</MudText>
        <div>
            <MudButton Variant="Variant.Outlined" Href="/">Return to home</MudButton>
        </div>
    </MudStack>
</MudContainer>
