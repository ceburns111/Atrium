@page "/storefront/cart"
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject CartService Cart
@inject CartPersistence Persistence
@inject NavigationManager Nav

<PageTitle>Cart</PageTitle>

<PageHeader Eyebrow="Storefront" Title="Cart" Description="Review your items before checking out." />

@if (Cart.Lines.Count == 0)
{
    <p class="empty">Your cart is empty. <a href="/storefront">Browse products</a>.</p>
}
else
{
    <div class="table-scroll">
        <table class="atrium-table cart-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th class="num">Price</th>
                    <th>Quantity</th>
                    <th class="num">Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Cart.Lines)
                {
                    <tr>
                        <td>@line.Product.Name</td>
                        <td class="num">$@line.Product.Price.ToString("N0")</td>
                        <td>
                            <div class="stepper">
                                <button class="stepper__btn" @onclick="() => Cart.SetQuantity(line.Product.Id, line.Quantity - 1)" aria-label="Decrease quantity">&minus;</button>
                                <span class="stepper__n">@line.Quantity</span>
                                <button class="stepper__btn" @onclick="() => Cart.SetQuantity(line.Product.Id, line.Quantity + 1)" aria-label="Increase quantity">+</button>
                            </div>
                        </td>
                        <td class="num">$@((line.Product.Price * line.Quantity).ToString("N0"))</td>
                        <td class="num">
                            <Button Variant="ButtonVariant.Ghost" Small="true" OnClick="() => Cart.Remove(line.Product.Id)">Remove</Button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="cart-summary">
        <div class="cart-summary__total">
            <span>Total</span>
            <strong>$@Cart.Total.ToString("N0")</strong>
        </div>
        <AuthorizeView>
            <Authorized>
                <Button Variant="ButtonVariant.Accent" OnClick="@(() => Nav.NavigateTo("/storefront/checkout"))">Proceed to checkout</Button>
            </Authorized>
            <NotAuthorized>
                <Notice Title="Sign in to check out"
                        Body="Sign in or create an account to place your order — your cart will be waiting.">
                    <a class="btn btn--accent" href="/account/login?returnUrl=%2Fstorefront%2Fcart">Sign in</a>
                </Notice>
            </NotAuthorized>
        </AuthorizeView>
    </div>
}

@code {
    protected override void OnInitialized() => Cart.Changed += Refresh;

    // Rehydrate the persisted cart on the first INTERACTIVE render only — never during prerender, when
    // JS interop is unavailable (ADR-0010). This is what carries the cart across the full-page sign-in.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Persistence.HydrateAsync();
        }
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= Refresh;
}
