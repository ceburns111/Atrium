@namespace Atrium.Design

<span class="badge @VariantClass @Class" @attributes="Extra">@ChildContent</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Neutral;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? Extra { get; set; }

    string VariantClass => Variant switch
    {
        BadgeVariant.Success => "badge--success",
        BadgeVariant.Warning => "badge--warning",
        BadgeVariant.Danger => "badge--danger",
        _ => "",
    };
}
