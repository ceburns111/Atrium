@page "/admin"
@attribute [Authorize(Roles = "admin")]
@inject AdminCatalogClient Catalog
@inject ISnackbar Snackbar

<PageTitle>Admin</PageTitle>

<MudStack Class="mb-6">
    <MudText Typo="Typo.overline" Color="Color.Primary">Admin</MudText>
    <MudText Typo="Typo.h4">Products</MudText>
    <MudText Typo="Typo.body1">
        Create and edit catalog products. Saving requires the admin role — sign in as admin to make
        changes.
    </MudText>
</MudStack>

@if (_failed)
{
    <MudStack Class="mb-4" Spacing="2">
        <MudAlert Severity="Severity.Error">
            <MudText Typo="Typo.subtitle1">Couldn't load products</MudText>
            <MudText Typo="Typo.body2">Something interrupted the request. Please try again.</MudText>
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@Load">
            Try again
        </MudButton>
    </MudStack>
}
else
{
    @* No Bordered: vertical cell borders rendered raggedly against the flex-aligned action column;
       horizontal row dividers + hover read cleaner and match the other tables. *@
    <MudDataGrid T="ProductDto"
                 Items="@(_products ?? [])"
                 Loading="@(_products is null)"
                 Hover="true"
                 Elevation="0">
        <ToolBarContent>
            <MudSpacer />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="StartCreate">
                New product
            </MudButton>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Category" Title="Category">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                        @context.Item.Category
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Price"
                            Title="Price"
                            HeaderClass="text-right"
                            CellClass="text-right">
                <CellTemplate>@Money.Format(context.Item.Price)</CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Blurb" Title="Blurb" />
            <TemplateColumn Title="" Sortable="false" CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   aria-label="Edit"
                                   OnClick="@(() => StartEdit(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">No products yet.</MudText>
        </NoRecordsContent>
    </MudDataGrid>
}

@* One dialog + one form serves both create and edit — _editingId (null = create) picks the mode. *@
<MudDialog @bind-Visible="_dialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm>
            <MudTextField T="string"
                          Label="Name"
                          @bind-Value="_form.Name"
                          Immediate="true"
                          Required="true"
                          Placeholder="Walnut Monitor Shelf"
                          Class="mb-3" />
            <MudSelect T="string" Label="Category" @bind-Value="_form.Category" Class="mb-3">
                @foreach (var category in _categories)
                {
                    <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="decimal"
                             Label="Price"
                             @bind-Value="_form.Price"
                             Immediate="true"
                             Min="0.01M"
                             Step="0.01M"
                             Format="F2"
                             Class="mb-3" />
            <MudTextField T="string"
                          Label="Blurb"
                          @bind-Value="_form.Blurb"
                          Immediate="true"
                          Required="true"
                          Placeholder="One-line description." />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving" Variant="Variant.Text" Color="Color.Default">
            Cancel
        </MudButton>
        <MudButton OnClick="Save"
                   Disabled="_saving || !FormValid"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            @SaveLabel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<ProductDto>? _products;
    private IReadOnlyList<string> _categories = [];
    private int? _editingId; // null = creating a new product
    private bool _dialogOpen;
    private bool _saving;
    private bool _failed;
    private readonly ProductForm _form = new();

    // Inline MudDialog: @bind-Visible drives _dialogOpen, so Esc / backdrop / close-button all route
    // back through the flag exactly like the old Dialog's OpenChanged did.
    private static readonly DialogOptions _dialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
    };

    private string DialogTitle => _editingId is null ? "New product" : "Edit product";
    private string SaveLabel => _editingId is null ? "Add product" : "Save";

    // Client-side gate so an empty Name/Blurb or a zero Price can't be submitted for a server 400
    // round-trip; the Save button stays disabled until the form is valid. Price must round-trip
    // through the displayed cents precision (DECIMAL(10,2) in the schema, Money.Format on screen),
    // so anything past two decimals is rejected here rather than silently truncated later.
    private bool FormValid =>
        !string.IsNullOrWhiteSpace(_form.Name)
        && !string.IsNullOrWhiteSpace(_form.Blurb)
        && !string.IsNullOrWhiteSpace(_form.Category)
        && _form.Price > 0
        && decimal.Round(_form.Price, 2) == _form.Price;

    protected override Task OnInitializedAsync() => Load();

    // Guard the initial read so a non-session failure gets an inline retry instead of the shell's
    // generic card. (The create/edit write path already surfaces failures as inline toasts.) A 401
    // still bubbles as SessionExpiredException so the shell's re-login prompt wins.
    private async Task Load()
    {
        _failed = false;
        try
        {
            if (_categories.Count == 0)
            {
                _categories = (await Catalog.GetCategoriesAsync()).Select(c => c.Name).ToList();
            }
            _products = await Catalog.GetProductsAsync();
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            _failed = true;
        }
    }

    private void StartCreate()
    {
        _form.Reset(_categories.FirstOrDefault() ?? "");
        _editingId = null;
        _dialogOpen = true;
    }

    private void StartEdit(ProductDto product)
    {
        _form.Set(product);
        _editingId = product.Id;
        _dialogOpen = true;
    }

    private void Cancel() => _dialogOpen = false;

    private async Task Save()
    {
        // Belt-and-suspenders with the disabled Save button: ignore a re-entrant call while a save is
        // already in flight, matching Checkout.Pay's guard.
        if (_saving)
        {
            return;
        }
        _saving = true;
        try
        {
            var (product, error) = _editingId is null
                ? await Catalog.CreateProductAsync(
                    new CreateProductRequest(_form.Name, _form.Category, _form.Price, _form.Blurb)
                )
                : await Catalog.UpdateProductAsync(
                    _editingId.Value,
                    new UpdateProductRequest(_form.Name, _form.Category, _form.Price, _form.Blurb)
                );

            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
                return; // keep the dialog open so the user can fix and retry
            }

            Snackbar.Add(
                $"{(_editingId is null ? "Created" : "Saved")} {product!.Name}",
                Severity.Success
            );
            _dialogOpen = false;
            await Load();
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            // A transient failure (e.g. a 502 from the gateway) stays an inline toast, matching
            // Checkout.Pay's shape: the dialog stays open with the typed edits intact so the user
            // can just retry. A 401 still bubbles as SessionExpiredException for the shell's
            // re-login prompt.
            Snackbar.Add(
                "Something went wrong saving the product. Please try again.",
                Severity.Error
            );
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class ProductForm
    {
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Price { get; set; }
        public string Blurb { get; set; } = "";

        public void Reset(string category)
        {
            Name = "";
            Category = category;
            Price = 0;
            Blurb = "";
        }

        public void Set(ProductDto product)
        {
            Name = product.Name;
            Category = product.Category;
            Price = product.Price;
            Blurb = product.Blurb;
        }
    }
}
