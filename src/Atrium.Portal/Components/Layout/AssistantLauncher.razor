@namespace Atrium.Portal.Components.Layout
@implements IDisposable
@inject Atrium.Portal.Modularity.ModuleCatalog Catalog
@inject NavigationManager Nav

@* The shell's assistant launcher: renders a chat surface contributed by a module (via
   IModule.AgentSurfaces), context-aware to the active section. Placed in the topbar behind an
   AuthorizeView (see MainLayout) so only signed-in users see it — the agent endpoint is authenticated
   regardless. The chat itself lives in the shared <AgentChat> primitive. *@
@if (_surface is not null)
{
    @* Icon-only in the topbar (name lives in the tooltip) so it matches the theme toggle's treatment —
       the label reappears on the Dialog title once opened. *@
    <button
        type="button"
        class="btn btn--ghost btn--sm"
        @onclick="() => _open = true"
        aria-label="Open @_surface.Name"
        title="Open @_surface.Name"
    >
        @* Chat bubble — inline SVG in the house style (stroke=currentColor), no icon dependency. *@
        <svg
            class="topbar__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
            />
        </svg>
    </button>

    <Dialog @bind-Open="_open" Title="@_surface.Name">
        <AgentChat
            Endpoint="@_surface.Endpoint"
            StarterPrompts="@_surface.StarterPrompts"
            Title="@_surface.Name"
        />
    </Dialog>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _open;
    private Atrium.Abstractions.AgentSurface? _surface;
    private System.Security.Claims.ClaimsPrincipal? _user;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    // Resolve the signed-in user once per parameter set, then pick the surface. The cached principal lets
    // the (synchronous) LocationChanged handler re-pick without re-awaiting the auth state each navigation.
    protected override async Task OnParametersSetAsync()
    {
        _user = AuthState is null ? null : (await AuthState).User;
        _surface = ResolveSurface();
    }

    // Re-pick the surface when the section changes, so the launcher targets the module you're in.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var next = ResolveSurface();
        // Compare by Endpoint (the surface's stable identity), not the record itself: AgentSurfaces is a
        // computed property that allocates a fresh record — and a fresh StarterPrompts array — every call,
        // so record value-equality (which compares the array by reference) would always differ and force a
        // re-render on every navigation. The endpoint is what actually changes when the surface changes.
        if (next?.Endpoint != _surface?.Endpoint)
        {
            _surface = next;
            InvokeAsync(StateHasChanged);
        }
    }

    // Prefer the active top-level section's module surface; otherwise the first surface any visible module
    // offers. Only modules the user can actually see are considered — the same role gate the nav and home
    // cards use — so a role-gated module's agent never leaks to a user without the role.
    private Atrium.Abstractions.AgentSurface? ResolveSurface()
    {
        // Ordered deterministically so the off-section fallback doesn't depend on module discovery order.
        var visible = Catalog
            .Modules.Where(m => IsVisible(m, _user))
            .OrderBy(m => m.BasePath, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var section = new Uri(Nav.Uri)
            .AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault();

        if (section is not null)
        {
            var active = visible.FirstOrDefault(m =>
                string.Equals(m.BasePath.Trim('/'), section, StringComparison.OrdinalIgnoreCase)
            );
            var surface = active?.AgentSurfaces.FirstOrDefault();
            if (surface is not null)
            {
                return surface;
            }
        }

        return visible.SelectMany(m => m.AgentSurfaces).FirstOrDefault();
    }

    // A module (and thus its agent surface) is visible when it has no required role, or the signed-in user
    // is in that role — identical to NavMenu.IsVisible / the home-card gate.
    private static bool IsVisible(
        Atrium.Abstractions.IModule module,
        System.Security.Claims.ClaimsPrincipal? user
    ) => module.RequiredRole is null || (user?.IsInRole(module.RequiredRole) ?? false);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
