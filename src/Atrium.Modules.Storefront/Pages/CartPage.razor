@page "/storefront/cart"
@attribute [Authorize]
@implements IDisposable
@inject CartService Cart
@inject ToastService Toasts
@inject OrdersClient Orders
@inject NavigationManager Nav

<PageTitle>Cart</PageTitle>

<PageHeader Eyebrow="Storefront" Title="Cart" Description="Review your items before placing the order." />

@if (Cart.Lines.Count == 0)
{
    <p class="empty">Your cart is empty. <a href="/storefront">Browse products</a>.</p>
}
else
{
    <div class="table-scroll">
        <table class="atrium-table cart-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th class="num">Price</th>
                    <th>Quantity</th>
                    <th class="num">Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Cart.Lines)
                {
                    <tr>
                        <td>@line.Product.Name</td>
                        <td class="num">$@line.Product.Price.ToString("N0")</td>
                        <td>
                            <div class="stepper">
                                <button class="stepper__btn" @onclick="() => Cart.SetQuantity(line.Product.Id, line.Quantity - 1)" aria-label="Decrease quantity">&minus;</button>
                                <span class="stepper__n">@line.Quantity</span>
                                <button class="stepper__btn" @onclick="() => Cart.SetQuantity(line.Product.Id, line.Quantity + 1)" aria-label="Increase quantity">+</button>
                            </div>
                        </td>
                        <td class="num">$@((line.Product.Price * line.Quantity).ToString("N0"))</td>
                        <td class="num">
                            <Button Variant="ButtonVariant.Ghost" Small="true" OnClick="() => Cart.Remove(line.Product.Id)">Remove</Button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="cart-summary">
        <div class="cart-summary__total">
            <span>Total</span>
            <strong>$@Cart.Total.ToString("N0")</strong>
        </div>
        <Button Variant="ButtonVariant.Accent" OnClick="PlaceOrder" Disabled="_placing">@(_placing ? "Placing…" : "Place order")</Button>
    </div>
}

@code {
    private bool _placing;

    // One idempotency key per checkout attempt. It is reused across retries of the same cart (so the
    // server dedupes and can't create a duplicate order) and only rotated after a successful placement.
    private Guid _orderKey = Guid.NewGuid();

    private async Task PlaceOrder()
    {
        // Guard against a double-click placing the order twice while the request is in flight.
        if (_placing)
        {
            return;
        }
        _placing = true;
        try
        {
            var request = new CreateOrderRequest(
                Cart.Lines.Select(l => new OrderItemRequest(l.Product.Id, l.Quantity)).ToList(),
                _orderKey
            );
            var order = await Orders.CreateAsync(request);
            Cart.Clear();
            _orderKey = Guid.NewGuid(); // the next checkout is a distinct order
            Toasts.Show($"Order placed — ${order?.Total ?? 0:N0}", ToastVariant.Success);
            Nav.NavigateTo("/storefront/orders");
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            // Let SessionExpiredException propagate to the error boundary (re-login); swallow only real
            // per-request failures. Keep the cart and the same idempotency key so retrying reuses it:
            // because the server dedupes on that key, a retry after an ambiguous failure returns the
            // original order rather than placing a second one.
            Toasts.Show("Couldn't place your order — please try again.", ToastVariant.Danger);
        }
        finally
        {
            _placing = false;
        }
    }

    protected override void OnInitialized() => Cart.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= Refresh;
}
