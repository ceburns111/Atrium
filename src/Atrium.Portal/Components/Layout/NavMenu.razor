@inject Atrium.Portal.Modularity.ModuleCatalog Catalog

<div class="brand">
    @* Custom "skylight" mark — a light-well viewed top-down — not a borrowed icon set. *@
    <svg viewBox="0 0 28 28" class="brand__mark" fill="none" aria-hidden="true">
        <rect x="3" y="3" width="22" height="22" rx="6" stroke="currentColor" stroke-width="2" />
        <rect x="10" y="10" width="8" height="8" rx="2" fill="currentColor" />
    </svg>
    <span class="brand__name">Atrium</span>
</div>

<nav class="nav">
    <NavLink class="nav__link" href="" Match="NavLinkMatch.All">Home</NavLink>

    @if (Catalog.Modules.Count > 0)
    {
        <div class="nav__label">Apps</div>
        @* Navigation is contributed by discovered modules, not hard-coded. *@
        @foreach (var module in Catalog.Modules)
        {
            @foreach (var item in module.NavItems)
            {
                @* A link inherits its module's role when it declares none of its own — otherwise a
                   role-gated module's links would render for everyone while the route stays forbidden. *@
                var role = item.RequiredRole ?? module.RequiredRole;
                @if (role is null)
                {
                    <NavLink class="nav__link" href="@item.Path">@item.Title</NavLink>
                }
                else
                {
                    <AuthorizeView Roles="@role">
                        <Authorized>
                            <NavLink class="nav__link" href="@item.Path">@item.Title</NavLink>
                        </Authorized>
                    </AuthorizeView>
                }
            }
        }
    }

    <div class="nav__spacer"></div>
    @* When some modules are role-gated away, show what this user can see vs what's loaded. *@
    <div class="nav__foot">
        @if (_visibleCount == Catalog.Modules.Count)
        {
            @($"{Catalog.Modules.Count} module{(Catalog.Modules.Count == 1 ? "" : "s")} loaded")
        }
        else
        {
            @($"{_visibleCount} of {Catalog.Modules.Count} modules visible")
        }
    </div>
</nav>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private int _visibleCount;

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        _visibleCount = Catalog.Modules.Count(m =>
            Atrium.Portal.Modularity.ModuleVisibility.IsVisible(m, user)
        );
    }
}
