@namespace Atrium.Design
@implements IAsyncDisposable
@inject AgentChatClientFactory Factory
@inject IJSRuntime JS
@using Microsoft.Extensions.AI

@* A reusable support-agent chat over AG-UI. The shell and modules render it pointed at a gateway-relative
   agent endpoint (e.g. "storefront/agent"); it streams the assistant reply token-by-token via the
   AGUIChatClient and shows tool activity as small cards. Text + tool cards only — no generative UI. *@
<section class="agent-chat" aria-label="@Heading">
    <header class="agent-chat__header">
        <span class="agent-chat__eyebrow">Agent</span>
        <h2 class="agent-chat__title">@Heading</h2>
    </header>

    <div class="agent-chat__log" role="log" aria-live="polite" @ref="_logRef">
        @if (_turns.Count == 0)
        {
            <p class="agent-chat__empty">Ask a question to get started.</p>
        }
        @foreach (var turn in _turns)
        {
            <div class="agent-chat__msg agent-chat__msg--@(turn.Role == ChatRole.User ? "user" : "assistant")">
                <span class="agent-chat__who">@(turn.Role == ChatRole.User ? "You" : Heading)</span>
                @if (turn.Tools.Count > 0)
                {
                    <div class="agent-chat__tools">
                        @foreach (var tool in turn.Tools)
                        {
                            <span class="agent-chat__tool">
                                <span class="agent-chat__tool-name">@tool.Name</span>
                                <Badge Variant="@(tool.Done ? BadgeVariant.Success : BadgeVariant.Neutral)">
                                    @(tool.Done ? "done" : "running…")
                                </Badge>
                            </span>
                        }
                    </div>
                }
                @if (turn.Text.Length > 0)
                {
                    <div class="agent-chat__bubble">@turn.Text</div>
                }
                else if (turn.Role == ChatRole.Assistant && _busy)
                {
                    <div class="agent-chat__bubble agent-chat__bubble--typing"><span class="agent-chat__caret"></span></div>
                }
            </div>
        }
    </div>

    @if (_sessionExpired)
    {
        <Notice Title="Your session expired" Body="Sign in again to keep chatting with the agent." />
    }
    else if (_error is not null)
    {
        <Notice Title="The agent is unavailable" Body="@_error" />
    }

    @if (StarterPrompts is { Length: > 0 } && _turns.Count == 0)
    {
        <div class="agent-chat__starters">
            @foreach (var prompt in StarterPrompts)
            {
                <button type="button" class="agent-chat__chip" disabled="@_busy" @onclick="() => SendAsync(prompt)">
                    @prompt
                </button>
            }
        </div>
    }

    <form class="agent-chat__composer" @onsubmit="Submit" @onsubmit:preventDefault>
        <input class="input agent-chat__input"
               placeholder="Message the agent…"
               aria-label="Message the agent"
               disabled="@_busy"
               @bind="_draft"
               @bind:event="oninput" />
        <Button Type="submit" Variant="ButtonVariant.Accent" Disabled="@(_busy || string.IsNullOrWhiteSpace(_draft))">
            Send
        </Button>
    </form>
</section>

@code {
    [Parameter, EditorRequired] public string Endpoint { get; set; } = "";
    [Parameter] public string[]? StarterPrompts { get; set; }
    [Parameter] public string? Title { get; set; }

    private readonly List<Turn> _turns = [];
    private string _draft = "";
    private bool _busy;
    private string? _error;
    private bool _sessionExpired;

    private IChatClient? _chat;
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _module;
    private ElementReference _logRef;
    private bool _rendered;

    private string Heading => string.IsNullOrWhiteSpace(Title) ? "Support" : Title;

    private Task Submit() => SendAsync(_draft);

    private async Task SendAsync(string text)
    {
        text = text.Trim();
        if (text.Length == 0 || _busy)
        {
            return;
        }

        _draft = "";
        _error = null;
        _sessionExpired = false;
        _busy = true;

        _turns.Add(new Turn(ChatRole.User) { Text = text });
        var reply = new Turn(ChatRole.Assistant);
        _turns.Add(reply);
        await ScrollToEndAsync();

        _chat ??= Factory.Create(Endpoint);
        _cts = new CancellationTokenSource();
        try
        {
            // Send the whole conversation so far (the still-empty assistant turn is excluded) as context.
            var request = _turns
                .Where(t => !ReferenceEquals(t, reply))
                .Select(t => new ChatMessage(t.Role, t.Text))
                .ToList();

            await foreach (
                var update in _chat.GetStreamingResponseAsync(request, cancellationToken: _cts.Token)
            )
            {
                foreach (var content in update.Contents)
                {
                    switch (content)
                    {
                        case TextContent text2:
                            reply.Text += text2.Text;
                            break;
                        case FunctionCallContent call:
                            reply.Tools.Add(new Turn.ToolTrace(call.Name));
                            break;
                        case FunctionResultContent:
                            var pending = reply.Tools.LastOrDefault(t => !t.Done);
                            if (pending is not null)
                            {
                                pending.Done = true;
                            }
                            break;
                    }
                }
                StateHasChanged();
                await ScrollToEndAsync();
            }
        }
        catch (SessionExpiredException)
        {
            _sessionExpired = true;
            _turns.Remove(reply);
        }
        catch (OperationCanceledException)
        {
            // Teardown/navigation cancelled the stream — nothing to surface.
        }
        catch (Exception)
        {
            _error = "Something went wrong reaching the agent. Try again in a moment.";
            _turns.Remove(reply);
        }
        finally
        {
            _busy = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _rendered = true;
        }
    }

    private async Task ScrollToEndAsync()
    {
        // JS only exists after the first interactive render; skip during prerender and tolerate a
        // circuit that went away mid-stream (same guard as the Dialog primitive).
        if (!_rendered)
        {
            return;
        }
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Atrium.Design/js/agentchat.js"
            );
            await _module.InvokeVoidAsync("scrollToEnd", _logRef);
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        (_chat as IDisposable)?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }

    // A single message in the transcript. Text grows as tokens stream; Tools records agent tool calls.
    private sealed class Turn(ChatRole role)
    {
        public ChatRole Role { get; } = role;
        public string Text { get; set; } = "";
        public List<ToolTrace> Tools { get; } = [];

        public sealed class ToolTrace(string name)
        {
            public string Name { get; } = name;
            public bool Done { get; set; }
        }
    }
}
