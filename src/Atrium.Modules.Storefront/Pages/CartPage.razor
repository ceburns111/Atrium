@page "/storefront/cart"
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject CartService Cart
@inject CartPersistence Persistence
@inject NavigationManager Nav

<PageTitle>Cart</PageTitle>

<MudStack Class="mb-6">
    <div>
        <MudText Typo="Typo.overline" Color="Color.Primary">Storefront</MudText>
        <MudText Typo="Typo.h4">Cart</MudText>
        <MudText Typo="Typo.body1">Review your items before checking out.</MudText>
    </div>
</MudStack>

@if (Cart.Lines.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        Your cart is empty. <MudLink Href="/storefront">Browse products</MudLink>.
    </MudAlert>
}
else
{
    <MudSimpleTable Hover="true" Class="mb-4">
        <thead>
            <tr>
                <th>Item</th>
                <th style="text-align:right">Price</th>
                <th>Quantity</th>
                <th style="text-align:right">Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Cart.Lines)
            {
                <tr>
                    <td>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <ProductThumb Name="@line.Product.Name" Class="product-thumb--sm" />
                            <MudText>@line.Product.Name</MudText>
                        </MudStack>
                    </td>
                    <td style="text-align:right">@Money.Format(line.Product.Price)</td>
                    <td>
                        <MudNumericField T="int"
                                         Value="@line.Quantity"
                                         ValueChanged="@(v => Cart.SetQuantity(line.Product.Id, v))"
                                         Min="1"
                                         Style="width:6rem"
                                         Margin="Margin.Dense" />
                    </td>
                    <td style="text-align:right">@Money.Format(line.Product.Price * line.Quantity)</td>
                    <td>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       OnClick="@(() => Cart.Remove(line.Product.Id))"
                                       UserAttributes="_removeAttrs" />
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.subtitle1">Total</MudText>
            <MudText Typo="Typo.h6">@Money.Format(Cart.Total)</MudText>
        </MudStack>
    </MudPaper>

    <AuthorizeView>
        <Authorized>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@(() => Nav.NavigateTo("/storefront/checkout"))">
                Checkout
            </MudButton>
        </Authorized>
        <NotAuthorized>
            <MudAlert Severity="Severity.Info">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">Sign in to check out</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Sign in or create an account to place your order — your cart will be waiting.
                </MudText>
                <MudButton Href="/account/login?returnUrl=%2Fstorefront%2Fcart"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    Sign in
                </MudButton>
            </MudAlert>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    private static readonly Dictionary<string, object?> _removeAttrs = new() { ["title"] = "Remove" };

    protected override void OnInitialized() => Cart.Changed += Refresh;

    // Rehydrate the persisted cart on the first INTERACTIVE render only — never during prerender, when
    // JS interop is unavailable (ADR-0010). This is what carries the cart across the full-page sign-in.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Persistence.HydrateAsync();
        }
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= Refresh;
}
