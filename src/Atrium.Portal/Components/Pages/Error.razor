@* The UseExceptionHandler("/Error") re-execute target — statically rendered after an unhandled
   server-side exception. Same notice treatment as NotFound/Forbidden, plus the request id so a
   user report can be matched to the server logs/trace. *@
@page "/Error"
@layout MainLayout
@using System.Diagnostics

<PageTitle>Something went wrong</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5">Something went wrong</MudText>
        <MudText Typo="Typo.body1">An unexpected error occurred while processing your request.</MudText>
        @if (ShowRequestId)
        {
            <MudText Typo="Typo.body2">Request ID: <code>@RequestId</code></MudText>
        }
        <div>
            <MudButton Variant="Variant.Outlined" Href="/">Return to home</MudButton>
        </div>
    </MudStack>
</MudContainer>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
