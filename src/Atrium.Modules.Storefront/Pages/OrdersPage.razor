@page "/storefront/orders"
@attribute [Authorize]
@using System.Globalization
@inject OrdersClient Orders

<PageTitle>Orders</PageTitle>

<PageHeader Eyebrow="Storefront" Title="Orders" Description="Your order history, served by the Storefront app service from its own database.">
    <Actions>
        <a class="btn btn--secondary" href="/storefront">Browse</a>
    </Actions>
</PageHeader>

@if (_failed)
{
    <Notice Title="Couldn't load your orders"
            Body="Something interrupted the request. Please try again.">
        <Button Variant="ButtonVariant.Secondary" OnClick="Load">Try again</Button>
    </Notice>
}
else if (_orders is null)
{
    @for (var i = 0; i < 3; i++)
    {
        <div class="card order-card">
            <div class="order-card__head">
                <span class="skeleton skeleton-line"></span>
            </div>
            <span class="skeleton skeleton-line"></span>
        </div>
    }
}
else if (_orders.Count == 0)
{
    <p class="empty">No orders yet. <a href="/storefront">Browse products</a>.</p>
}
else
{
    @foreach (var order in _orders)
    {
        <div class="card order-card">
            <div class="order-card__head">
                <span class="order-card__id">Order #@order.Id</span>
                @* Rendered in Blazor Server, so ToLocalTime() would be the SERVER's timezone (UTC in a
                   container), not the visitor's — render the stored UTC instant honestly instead. *@
                <span class="order-card__date">@order.PlacedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)</span>
                <span class="order-card__total">@Money.Format(order.Total)</span>
            </div>
            <table class="atrium-table">
                <tbody>
                    @foreach (var line in order.Lines)
                    {
                        <tr>
                            <td>@line.ProductName</td>
                            <td class="num">@Money.Format(line.UnitPrice)</td>
                            <td class="num">×@line.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private IReadOnlyList<OrderDto>? _orders;
    private bool _failed;

    protected override Task OnInitializedAsync() => Load();

    // Reads are idempotent, so a non-session failure gets an inline retry rather than the shell's
    // generic error card; a 401 still bubbles as SessionExpiredException for the re-login prompt.
    private async Task Load()
    {
        _failed = false;
        _orders = null;
        try
        {
            _orders = await Orders.GetOrdersAsync();
        }
        catch (Exception ex) when (ex is not SessionExpiredException)
        {
            _failed = true;
        }
    }
}
