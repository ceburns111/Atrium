@namespace Atrium.Design
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Flips the document's data-theme between light and dark and persists the choice to localStorage.
   The host page applies the stored/system theme before first paint (no flash); this toggle only
   drives runtime changes. All interop is deferred to interactive events / OnAfterRender and guarded,
   so it never touches IJSRuntime during prerender (see ADR-0010). *@
<Button Variant="ButtonVariant.Ghost"
        Small="true"
        OnClick="Toggle"
        aria-label="@Label"
        title="@Label">
    @* Stroke SVGs (feather-style) so this shares the house icon system with the Support launcher —
       no more solid Unicode glyph sitting next to an outlined chat bubble. *@
    @if (_dark)
    {
        <svg class="topbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
    }
    else
    {
        <svg class="topbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
    }
</Button>

@code {
    private IJSObjectReference? _module;
    private bool _dark;

    private string Label => _dark ? "Switch to light theme" : "Switch to dark theme";

    // Sync the icon to whatever theme the host page already applied. Runs only after the first
    // interactive render — never during prerender — so the import is safe.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module ??= await Import();
            var dark = await _module.InvokeAsync<string>("get") == "dark";
            if (dark != _dark)
            {
                _dark = dark;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away between render and interop — nothing to sync.
        }
        catch (InvalidOperationException)
        {
            // Interop not available yet (prerender) — the next interactive render will sync.
        }
    }

    // User-initiated, so we're interactive here; still guarded for a circuit that drops mid-call.
    private async Task Toggle()
    {
        _dark = !_dark;
        try
        {
            _module ??= await Import();
            await _module.InvokeVoidAsync("set", _dark ? "dark" : "light");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private ValueTask<IJSObjectReference> Import() =>
        JS.InvokeAsync<IJSObjectReference>("import", "./_content/Atrium.Design/js/theme.js");

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to dispose.
            }
        }
    }
}
